# Binance API — needs Spot Trading permission enabled
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Email Alerts (optional)
# For Gmail: enable 2FA, create App Password at myaccount.google.com/apppasswords
ALERT_EMAIL_SENDER=your_gmail@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password
ALERT_EMAIL_RECIPIENT=your_email@gmail.com

# Optional: Claude AI for plain-English reasoning per alert
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Scanner Settings
SCAN_INTERVAL_SECONDS=300         # Scan every 5 minutes
DIP_THRESHOLD_24H=-20.0           # Major dip threshold %
DIP_THRESHOLD_1H=-10.0            # Sharp hourly drop %
VOLUME_SURGE_MULTIPLIER=3.0       # Volume spike multiplier
RSI_OVERSOLD=30                   # Oversold RSI level
MIN_VOLUME_USDT=5000000           # Min $5M daily volume
MAX_DROP_24H=-50.0                # Skip coins down >50% (dying coins)

# Trading Settings
DRY_RUN=true                      # true = simulate only | false = real money
MIN_BUY_SCORE=60                  # Minimum signal score to trigger a buy
MAX_OPEN_POSITIONS=3              # Max coins held at once
BALANCE_ALLOCATION_PCT=0.50       # Use 50% of available balance across positions
STOP_LOSS_PCT=-8.0                # Sell if down 8% from entry
TAKE_PROFIT_PCT=15.0              # Sell if up 15% from entry
DAILY_LOSS_CAP_PCT=0.50           # Stop trading if 50% of starting balance lost today
MONITOR_INTERVAL_SECONDS=120      # Check open positions every 2 minutes
MAX_HOLD_HOURS=24.0               # Force sell after 24 hours
