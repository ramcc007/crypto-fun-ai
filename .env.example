# Binance API - READ ONLY keys only. Never enable trading permissions here.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Email Alerts (use Gmail or any SMTP)
# For Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
ALERT_EMAIL_SENDER=your_gmail@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password
ALERT_EMAIL_RECIPIENT=your_email@gmail.com

# Optional: Claude AI for reasoning explanations
# Get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Scanner Settings (tweak these to your preference)
SCAN_INTERVAL_SECONDS=300         # How often to scan (300 = every 5 minutes)
DIP_THRESHOLD_24H=-20.0           # Alert if 24h change is below this %
DIP_THRESHOLD_1H=-10.0            # Alert if 1h change is below this %
VOLUME_SURGE_MULTIPLIER=3.0       # Alert if volume is Nx above average
RSI_OVERSOLD=30                   # RSI below this = oversold
MIN_VOLUME_USDT=5000000           # Ignore coins with <5M USDT daily volume
MAX_DROP_24H=-50.0                # Skip coins down more than 50% in 24h (dying coins)
